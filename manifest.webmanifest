{
  "name": "PROSOL Campo",
  "short_name": "PROSOL",
  "description": "Registro de mantenimientos de generadores Generac en sitio, sin internet.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1C2733",
  "theme_color": "#1C2733",
  "lang": "es",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/zip": [".zip", ".prosolcat"],
        "application/octet-stream": [".zip", ".prosolcat"]
      }
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "archivo", "accept": ["application/zip", ".zip", ".prosolcat", "application/octet-stream"] }
      ]
    }
  }
}
